# Do not track these files.

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]
__pycache__

# Log files
log/
*.log

# Package files
*.jar
/*egg-info/

# Maven
target/

# JetBrains IDE
.idea/
venv/

# Visual Studio
.vs*

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Temporary files
~$*.doc*
~$*.xls*
~$*.ppt*
/build/

# Full-resolution AI renders (tools/asset_gen/masters) are tracked with Git LFS (.gitattributes): the installed
# Graphics/*.png are converted from them. Rejected drawings and the superseded image-conditioned renders (hd/)
# stay local, as do generation logs and review state (work/).
tools/asset_gen/masters/hd/
tools/asset_gen/masters/**/rejected/
tools/asset_gen/work/
